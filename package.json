{
  "name": "tree-sitter-purosuco",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the PuroSuco programming language",
  "main": "bindings/node",
  "keywords": [
    "parsing",
    "tree-sitter",
    "purosuco"
  ],
  "author": "IgorPaslauski",
  "license": "MIT",
  "dependencies": {
    "nan": "^2.19.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.22.6"
  },
  "tree-sitter": [
    {
      "scope": "source.purosuco",
      "file-types": [
        "suco"
      ],
      "injection-regex": "^purosuco$"
    }
  ]
}
